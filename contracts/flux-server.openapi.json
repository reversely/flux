{
  "openapi": "3.1.0",
  "info": {
    "title": "flux stub inference server",
    "version": "0.1.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Healthz",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "boolean"
                  },
                  "type": "object",
                  "title": "Response Healthz Healthz Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/chat": {
      "post": {
        "summary": "Chat",
        "operationId": "chat_v1_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatAnswer"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions": {
      "post": {
        "summary": "Create Session",
        "operationId": "create_session_v1_sessions_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionCreated"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions/{session_id}/frames": {
      "post": {
        "summary": "Upload Frame",
        "operationId": "upload_frame_v1_sessions__session_id__frames_post",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_frame_v1_sessions__session_id__frames_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FrameUploadResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions/{session_id}/results": {
      "get": {
        "summary": "Session Results",
        "operationId": "session_results_v1_sessions__session_id__results_get",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResults"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions/{session_id}/frames/{frame_id}": {
      "get": {
        "summary": "Get Frame",
        "operationId": "get_frame_v1_sessions__session_id__frames__frame_id__get",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          },
          {
            "name": "frame_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Frame Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_upload_frame_v1_sessions__session_id__frames_post": {
        "properties": {
          "frame": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Frame"
          },
          "captured_at": {
            "type": "string",
            "title": "Captured At"
          }
        },
        "type": "object",
        "required": [
          "frame",
          "captured_at"
        ],
        "title": "Body_upload_frame_v1_sessions__session_id__frames_post"
      },
      "ChatAnswer": {
        "properties": {
          "answer_id": {
            "type": "string",
            "title": "Answer Id"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array",
            "title": "Citations"
          }
        },
        "type": "object",
        "required": [
          "answer_id",
          "text",
          "citations"
        ],
        "title": "ChatAnswer"
      },
      "ChatRequest": {
        "properties": {
          "question": {
            "type": "string",
            "title": "Question"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "ChatRequest"
      },
      "Citation": {
        "properties": {
          "anchor": {
            "type": "string",
            "title": "Anchor"
          },
          "chapter_number": {
            "type": "integer",
            "title": "Chapter Number"
          },
          "chapter_title": {
            "type": "string",
            "title": "Chapter Title"
          },
          "section_title": {
            "type": "string",
            "title": "Section Title"
          },
          "tile_id": {
            "type": "integer",
            "title": "Tile Id"
          }
        },
        "type": "object",
        "required": [
          "anchor",
          "chapter_number",
          "chapter_title",
          "section_title",
          "tile_id"
        ],
        "title": "Citation",
        "description": "One FM anchor an answer sentence came from (PRD 4.1 anchor IDs)."
      },
      "FrameUploadResponse": {
        "properties": {
          "frame_id": {
            "type": "string",
            "title": "Frame Id"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/RecordStub"
            },
            "type": "array",
            "title": "Results"
          }
        },
        "type": "object",
        "required": [
          "frame_id",
          "results"
        ],
        "title": "FrameUploadResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RecordStub": {
        "properties": {
          "record_id": {
            "type": "string",
            "title": "Record Id"
          }
        },
        "type": "object",
        "required": [
          "record_id"
        ],
        "title": "RecordStub"
      },
      "SessionCreated": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          }
        },
        "type": "object",
        "required": [
          "session_id"
        ],
        "title": "SessionCreated"
      },
      "SessionResults": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "in_progress",
              "complete"
            ],
            "title": "Status"
          },
          "records": {
            "items": {
              "$ref": "#/components/schemas/RecordStub"
            },
            "type": "array",
            "title": "Records"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "status",
          "records"
        ],
        "title": "SessionResults"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
